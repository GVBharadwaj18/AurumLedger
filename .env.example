# ==============================================================================
# AURUMLEDGER ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=8080

# ------------------------------------------------------------------------------
# OPTION 1: LOCAL DOCKER COMPOSE (Default - Recommended for local development)
# Run `docker compose up -d` and use these pre-configured values:
# ------------------------------------------------------------------------------
DATABASE_URL=host=localhost user=postgres password=postgres dbname=wallet_db port=5432 sslmode=disable
REDIS_ADDR=localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ------------------------------------------------------------------------------
# OPTION 2: FREE CLOUD HOSTING (Zero local installations required)
# ------------------------------------------------------------------------------
# 1. NEON DB (Free Serverless PostgreSQL): https://neon.tech
#    Create a free project -> Copy the "Connection string" from the dashboard.
#    Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# DATABASE_URL=postgresql://alex:Abc123xyz@ep-sparkling-leaf-999999.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. CLOUDAMQP (Free Hosted RabbitMQ - "Little Lemur" plan): https://cloudamqp.com
#    Create a free instance -> Copy the "AMQP URL".
#    Format: amqps://[user]:[password]@[host].rmq.cloudamqp.com/[vhost]
# RABBITMQ_URL=amqps://myuser:mypassword@lemur.rmq.cloudamqp.com/myvhost

# 3. UPSTASH (Free Serverless Redis): https://upstash.com
#    Create a free database -> Copy the "Redis URL".
#    Format: rediss://default:[password]@[endpoint].upstash.io:6379
# REDIS_URL=rediss://default:abc123xyz@us1-quick-tiger-12345.upstash.io:6379

# ------------------------------------------------------------------------------
# OPTION 3: ZERO-SETUP EMBEDDED SQLITE (Instant Local Run)
# If DATABASE_URL is not set or set to sqlite, AurumLedger automatically runs on
# an embedded SQLite database (no Postgres or Docker needed!)
# ------------------------------------------------------------------------------
# DATABASE_URL=sqlite://aurumledger.db
